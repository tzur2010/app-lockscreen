{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "$ch": {
        ".read": "$ch.matches(/^[A-Za-z0-9]{12}$/)",
        ".write": "auth != null && $ch.matches(/^[A-Za-z0-9]{12}$/) && (!data.exists() || data.child('owner').val() === auth.uid) && newData.exists()",
        ".validate": "newData.hasChildren(['owner', 'code', 'at'])",
        "owner": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "code": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
        "mode": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "at": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
