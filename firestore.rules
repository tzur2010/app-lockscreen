rules_version = '2';

// ===============================================================
// חוקי אבטחה ל-Magic Lock
// ---------------------------------------------------------------
// users/{uid}      בקשת גישה של מכשיר (uid = הזהות האנונימית של המכשיר)
//                  name, phone, deviceId, status, createdAt, updatedAt
// admins/{uid}     מסמך קיים = המשתמש הוא מנהל (נוצר ידנית בקונסול)
// app_config/main  latest_version, apk_url, message, published_at
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    // רשימת המנהלים: כל משתמש יכול רק לבדוק אם הוא עצמו מנהל. אין כתיבה מהאפליקציה.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      // מכשיר רואה רק את הבקשה של עצמו. המנהל רואה הכל.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // מכשיר יכול רק ליצור בקשה חדשה במצב "ממתין" - אף פעם לא לאשר את עצמו.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'deviceId', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'status', 'createdAt'])
        && validStr(request.resource.data.name, 2, 80)
        && validStr(request.resource.data.phone, 7, 20)
        && (!('deviceId' in request.resource.data) || validStr(request.resource.data.deviceId, 0, 16))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;

      // רק המנהל משנה סטטוס (אישור / ביטול גישה / החזרה).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'approved', 'blocked'];

      allow delete: if isAdmin();
    }

    // הגדרות עדכון: כולם קוראים, רק המנהל מפרסם.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
