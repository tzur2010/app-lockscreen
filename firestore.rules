rules_version = '2';

// ===============================================================
// חוקי אבטחה ל-Magic Lock
// ---------------------------------------------------------------
// users/{uid}      בקשת גישה של מכשיר (uid = הזהות האנונימית של המכשיר)
//                  name, phone, deviceId, status, createdAt, updatedAt
// admins/{uid}     מסמך קיים = המשתמש הוא מנהל (נוצר ידנית בקונסול)
// app_config/main  latest_version, apk_url, message, published_at
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // קוסם שהמנהל אישר (רק הוא יכול לשלוח משוב/תקלות ולהשתמש בגיבוי)
    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function validStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    // רשימת המנהלים: כל משתמש יכול רק לבדוק אם הוא עצמו מנהל. אין כתיבה מהאפליקציה.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid} {
      // מכשיר רואה רק את הבקשה של עצמו. המנהל רואה הכל.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // מכשיר יכול רק ליצור בקשה חדשה במצב "ממתין" - אף פעם לא לאשר את עצמו.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'deviceId', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'status', 'createdAt'])
        && validStr(request.resource.data.name, 2, 80)
        && validStr(request.resource.data.phone, 7, 20)
        && (!('deviceId' in request.resource.data) || validStr(request.resource.data.deviceId, 0, 16))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;

      // רק המנהל משנה סטטוס (אישור / ביטול גישה / החזרה).
      // המכשיר עצמו יכול לעדכן רק את נתוני השימוש שלו (זמן אחרון, מספר פתיחות, גרסה).
      // המנהל יכול גם לשלוח לקוסם הודעה אישית (adminMessage).
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'adminMessage', 'adminMessageAt'])
          && request.resource.data.status in ['pending', 'approved', 'blocked']
          && (!('adminMessage' in request.resource.data) || validStr(request.resource.data.adminMessage, 1, 2000)))
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'openCount', 'appVersion', 'stats'])
          && (!('stats' in request.resource.data) || validStr(request.resource.data.stats, 0, 3000))
          && request.resource.data.lastSeen == request.time
          && request.resource.data.openCount is int
          && request.resource.data.openCount <= 1000000
          && validStr(request.resource.data.appVersion, 0, 20));

      allow delete: if isAdmin();
    }

    // משוב: מכשיר רשום יכול רק לשלוח משוב בשמו. רק המנהל קורא ומוחק.
    match /feedback/{feedbackId} {
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'appVersion', 'os', 'model', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validStr(request.resource.data.text, 1, 2000)
        && (!('appVersion' in request.resource.data) || validStr(request.resource.data.appVersion, 0, 20))
        && (!('os' in request.resource.data) || validStr(request.resource.data.os, 0, 20))
        && (!('model' in request.resource.data) || validStr(request.resource.data.model, 0, 40))
        && request.resource.data.createdAt is timestamp;
      allow read, delete: if isAdmin();
      // המנהל רק מוסיף תשובה למשוב (לא משנה את תוכן המשוב עצמו)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt'])
        && validStr(request.resource.data.reply, 1, 2000);
    }

    // דיווח תקלות אוטומטי: מכשיר רשום שולח תקלה בשמו. רק המנהל קורא ומוחק.
    match /errors/{errorId} {
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['uid', 'msg', 'src', 'appVersion', 'model', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validStr(request.resource.data.msg, 1, 500)
        && validStr(request.resource.data.src, 0, 200)
        && validStr(request.resource.data.appVersion, 0, 20)
        && validStr(request.resource.data.model, 0, 40)
        && request.resource.data.createdAt is timestamp;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // גיבוי הגדרות: לפי קוד גיבוי אישי בן 12 תווים (הקוד הוא הסוד).
    // רק מכשיר רשום יכול לקרוא/לכתוב גיבוי, ואי אפשר לרשום את כל הגיבויים.
    match /backups/{code} {
      allow get: if isApproved()
        && code.size() == 12;
      allow create, update: if isApproved()
        && code.size() == 12
        && request.resource.data.keys().hasOnly(['data', 'owner', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 200000
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }

    // הגדרות עדכון: כולם קוראים, רק המנהל מפרסם.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
